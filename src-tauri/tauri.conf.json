{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Master-Display",
  "version": "2.0.0",
  "identifier": "com.masterdisplay.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "master",
        "title": "Ceremony & Stage Presentation Manager — Reji Konsolu",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"]
  }
}

